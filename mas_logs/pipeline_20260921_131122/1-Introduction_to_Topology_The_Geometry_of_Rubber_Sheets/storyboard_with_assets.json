{
  "topic": "Introduction to Topology: The Geometry of Rubber Sheets",
  "target_audience": "University students (non-math majors or early undergraduates)",
  "sections": [
    {
      "id": "section_1",
      "title": "The Hook: Geometry vs. Topology",
      "lecture_lines": [
        "Topology is rubber-sheet geometry.",
        "It ignores stretching and bending.",
        "Only properties remaining unchanged matter.",
        "Objects deform without tearing.",
        "Mug becomes donut easily."
      ],
      "animations": [
        "Draw a circle, label it 'Geometry' in #FFFFFF. (Line 1 color change: #FFFFFF)",
        "Morph circle into irregular shape, 'Geometry' label #FF4500. (Line 2 color change: #FF4500)",
        "Display triangle/square morphing, label 'Topology' #00CED1. (Line 3 color change: #00CED1)",
        "Highlight preservation of object continuity. (Line 4 color change: #FFFFFF)",
        "Animate warping into. (Line 5 color change: #FFFFFF)"
      ]
    },
    {
      "id": "section_2",
      "title": "Prerequisite Concept: Homeomorphism",
      "lecture_lines": [
        "Homeomorphism defines topological equivalence.",
        "Transform objects by continuous deformation.",
        "We cannot tear or glue.",
        "Square stretches into circle.",
        "They are equivalent shapes."
      ],
      "animations": [
        "Show 'Square' #FFFFFF and 'Circle' #FFFFFF. (Line 1: #FFFFFF)",
        "Morph into. (Line 2: #FFFFFF)",
        "Color morph path #32CD32, label 'Homeomorphic' #00CED1. (Line 3: #00CED1)",
        "Show prohibited action (red X) when tearing. (Line 4: #FFFFFF)",
        "Highlight equivalent shapes display. (Line 5: #FFFFFF)"
      ]
    },
    {
      "id": "section_3",
      "title": "The Key Invariant: Genus (The 'Hole' Count)",
      "lecture_lines": [
        "Genus is the hole count.",
        "It is a topological invariant.",
        "Different genus means distinct topology.",
        "Soccer ball has zero holes.",
        "Donut has one hole."
      ],
      "animations": [
        "Display sphere, label 'Genus 0' #FFFFFF. (Line 1: #FFFFFF)",
